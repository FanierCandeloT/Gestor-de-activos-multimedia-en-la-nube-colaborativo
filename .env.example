# Copia este archivo a .env.local y completa con tus credenciales reales.
# NUNCA subas .env.local al repositorio.

# Neon PostgreSQL (connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Supabase Storage (solo servidor; no usar prefijo NEXT_PUBLIC_)
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_BUCKET="Media-files"

# CORS: origen autorizado para llamar a /api/* desde un navegador.
# En local déjalo así; en producción usa la URL pública de la app.
ALLOWED_ORIGIN="http://localhost:3000"
